# Terminal 3 — funded testnet dev tenant private key (acts as org + agent).
# Claim one from the Terminal 3 Sandbox page: https://docs.terminal3.io/intro/about-t3
# Used by `npm run demo:real` and the opt-in /api/verify live route.
T3N_SANDBOX_TOKEN=0x4123...

# Network: testnet (default) or production.
T3N_ENV=testnet

# Set to 1 to enable the live /api/verify route (real testnet calls).
# Leave unset/0 for the public demo so the funded key is never required in prod.
T3N_LIVE=0

# Pinned deployed payroll contract version on testnet.
T3N_PAYROLL_VERSION=5.1.4
